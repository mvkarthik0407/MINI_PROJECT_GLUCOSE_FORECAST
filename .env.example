APP_ENV=development
# Required for staging/production bearer-token authentication. Use a long random secret.
AUTH_SECRET=
CGM_WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# For Docker Compose use: postgresql+psycopg://diabetes:<password>@db:5432/diabetes
DATABASE_URL=
POSTGRES_PASSWORD=
MODEL_PATH=/app/models/best_metabonet_gru_model.pth
SCALER_PATH=/app/scalers/metabonet_scaler.pkl
MODEL_DEVICE=cpu
SEQUENCE_LENGTH=48
# Google AI Studio. Keep the key secret and do not commit it.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
